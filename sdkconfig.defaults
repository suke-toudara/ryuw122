# Defaults for the RYUW122 UWB firmware.
# Regenerate sdkconfig with: idf.py set-target esp32c6 && idf.py build

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# The ranging loop is timing sensitive; a 1 kHz tick keeps the millisecond
# level delays used by the driver accurate.
CONFIG_FREERTOS_HZ=1000

# The module answers within a few tens of milliseconds, so a small UART FIFO
# threshold keeps the round trip short.
CONFIG_UART_ISR_IN_IRAM=y
