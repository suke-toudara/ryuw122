# idf.py で直接ビルドする場合の既定値。
# PlatformIO では env ごとに configs/anchor.defaults / configs/tag.defaults が
# 使われます（platformio.ini の board_build.cmake_extra_args を参照）。

CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# 測距ループはミリ秒単位の待ちを使うので 1 kHz tick にしておく
CONFIG_FREERTOS_HZ=1000

# UART 割り込みを IRAM に置いて取りこぼしを避ける
CONFIG_UART_ISR_IN_IRAM=y
